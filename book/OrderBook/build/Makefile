	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBook.dir\build.make CMakeFiles/OrderBook.dir/Traders/TraderAlgo.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBookTests.dir\build.make CMakeFiles/OrderBookTests.dir/Traders/TraderAlgo.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBookBenchmark.dir\build.make CMakeFiles/OrderBookBenchmark.dir/Traders/TraderAlgo.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\MarketServer.dir\build.make CMakeFiles/MarketServer.dir/Traders/TraderAlgo.cpp.s
.PHONY : Traders/TraderAlgo.cpp.s

main.obj: main.cpp.obj
.PHONY : main.obj

# target to build an object file
main.cpp.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBook.dir\build.make CMakeFiles/OrderBook.dir/main.cpp.obj
.PHONY : main.cpp.obj

main.i: main.cpp.i
.PHONY : main.i

# target to preprocess a source file
main.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBook.dir\build.make CMakeFiles/OrderBook.dir/main.cpp.i
.PHONY : main.cpp.i

main.s: main.cpp.s
.PHONY : main.s

# target to generate assembly for a file
main.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\OrderBook.dir\build.make CMakeFiles/OrderBook.dir/main.cpp.s
.PHONY : main.cpp.s

